HOST=0.0.0.0
PORT=1344
CORS_ORIGINS=http://localhost:3000,http://localhost:3013,http://localhost:8081,http://localhost:19006
APP_KEYS=replace-with-4-comma-separated-long-random-values
API_TOKEN_SALT=replace-with-long-random-value
ADMIN_JWT_SECRET=replace-with-long-random-value
TRANSFER_TOKEN_SALT=replace-with-long-random-value
JWT_SECRET=replace-with-long-random-value

DATABASE_CLIENT=mysql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=placo
DATABASE_USERNAME=placo_user
DATABASE_PASSWORD=change-me
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Distinct, high-entropy HMAC secrets; configure only on the trusted services that need each integration.
MATCH_ENGINE_HMAC_SECRET=replace-with-at-least-32-random-bytes
PLA_INTEGRATION_HMAC_SECRET=replace-with-at-least-32-random-bytes
STORE_VERIFIER_HMAC_SECRET=replace-with-at-least-32-random-bytes
AD_SERVER_HMAC_SECRET=replace-with-at-least-32-random-bytes

PLA_BASE_URL=https://pla.example.invalid
PLA_RESULT_PATH=/api/integration/placo/results
# Server-to-server account validation endpoint; this is not a browser URL.
PLA_API_URL=http://localhost:1377/api
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_API_BASE=https://v6.exchangerate-api.com/v6
MATCH_RESULT_MAX_AGE_SECONDS=300
INTERNAL_SIGNATURE_MAX_SKEW_SECONDS=300

# Optional store receipt verifier URL/token should be server-side only. Never accept a client-supplied success flag.
STORE_RECEIPT_VERIFIER_URL=
STORE_RECEIPT_VERIFIER_TOKEN=

# Storage/replay index (keep binaries outside the relational DB in production).
REPLAY_STORAGE_BASE_URL=
