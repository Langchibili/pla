{
  "kind": "collectionType",
  "collectionName": "countries",
  "info": {
    "singularName": "country",
    "pluralName": "countries",
    "displayName": "Country",
    "description": "Country registry patterned after PLA: local currency plus optional overrides for gameplay, rewards, pricing and feature availability."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "iso_code": {
      "type": "string",
      "required": true,
      "unique": true,
      "minLength": 2,
      "maxLength": 3
    },
    "dial_code": {
      "type": "string"
    },
    "default_currency": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::currency.currency",
      "inversedBy": "countries"
    },
    "country_status": {
      "type": "enumeration",
      "enum": [
        "active",
        "inactive"
      ],
      "required": true,
      "default": "active"
    },
    "initial_bronze_coins": {
      "type": "integer",
      "min": 0
    },
    "initial_diamond_coins": {
      "type": "integer",
      "min": 0
    },
    "max_xp_win_override": {
      "type": "integer",
      "min": 0
    },
    "max_xp_match_override": {
      "type": "integer",
      "min": 0
    },
    "max_xp_training_override": {
      "type": "integer",
      "min": 0
    },
    "bronze_win_reward_override": {
      "type": "integer",
      "min": 0
    },
    "bronze_draw_reward_override": {
      "type": "integer",
      "min": 0
    },
    "bronze_loss_reward_override": {
      "type": "integer",
      "min": 0
    },
    "rewarded_ad_bronze_coins_override": {
      "type": "integer",
      "min": 0
    },
    "rewarded_ad_diamond_coins_override": {
      "type": "integer",
      "min": 0
    },
    "max_rewarded_ads_per_day_override": {
      "type": "integer",
      "min": 0
    },
    "cash_tournaments_allowed": {
      "type": "boolean",
      "default": false
    },
    "store_enabled_override": {
      "type": "boolean"
    },
    "rewarded_ads_enabled_override": {
      "type": "boolean"
    },
    "tournament_feature_flags": {
      "type": "json",
      "default": {}
    }
  }
}
