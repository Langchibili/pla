{
  "kind": "collectionType",
  "collectionName": "player_templates",
  "info": {
    "singularName": "player-template",
    "pluralName": "player-templates",
    "displayName": "Player Template",
    "description": "Admin-created player archetype/card with default identity, position slot, physical measurements and the full 1–100 attribute set."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "internal_name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "display_name": {
      "type": "string",
      "required": true
    },
    "position_number": {
      "type": "integer",
      "required": true,
      "min": 1,
      "max": 99
    },
    "primary_position": {
      "type": "enumeration",
      "enum": [
        "GK",
        "CB",
        "FB",
        "DM",
        "CM",
        "AM",
        "W",
        "ST"
      ],
      "required": true,
      "default": "CM"
    },
    "secondary_positions": {
      "type": "json",
      "default": []
    },
    "height_cm": {
      "type": "integer",
      "default": 180,
      "min": 160,
      "max": 205
    },
    "weight_kg": {
      "type": "integer",
      "default": 75,
      "min": 55,
      "max": 100
    },
    "preferred_foot": {
      "type": "enumeration",
      "enum": [
        "L",
        "R"
      ],
      "required": true,
      "default": "R"
    },
    "attributes": {
      "type": "json",
      "required": true,
      "default": {
        "sprintSpeed": 65,
        "acceleration": 65,
        "agility": 60,
        "balance": 60,
        "strength": 60,
        "stamina": 65,
        "jumping": 60,
        "dribbling": 55,
        "ballControl": 55,
        "shortPassing": 55,
        "longPassing": 50,
        "crossing": 45,
        "finishing": 45,
        "shotPower": 60,
        "longShots": 45,
        "volleys": 40,
        "curve": 45,
        "freeKickAccuracy": 40,
        "penalties": 50,
        "headingAccuracy": 50,
        "standingTackle": 45,
        "slideTackle": 40,
        "interceptions": 45,
        "marking": 45,
        "aggression": 55,
        "vision": 50,
        "composure": 50,
        "reactions": 55,
        "attackPositioning": 50,
        "defendPositioning": 45,
        "anticipation": 50,
        "decisions": 50,
        "workRate": 60,
        "weakFoot": 50,
        "reflexes": 30,
        "diving": 30,
        "handling": 30,
        "kicking": 30,
        "throwing": 30,
        "gkPositioning": 30,
        "oneOnOnes": 30,
        "commandOfArea": 30,
        "aerialReach": 30,
        "penaltySaving": 30,
        "sweepingSpeed": 30
      }
    },
    "goalkeeper_attributes": {
      "type": "json",
      "default": {
        "reflexes": 30,
        "diving": 30,
        "handling": 30,
        "kicking": 30,
        "throwing": 30,
        "positioning": 30,
        "oneOnOnes": 30,
        "commandOfArea": 30,
        "aerialReach": 30,
        "penaltySaving": 30,
        "sweepingSpeed": 30
      }
    },
    "traits": {
      "type": "json",
      "default": []
    },
    "player_archetype": {
      "type": "enumeration",
      "enum": [
        "keeper",
        "defender",
        "fullback",
        "defensive_midfielder",
        "midfielder",
        "attacking_midfielder",
        "winger",
        "striker"
      ],
      "default": "midfielder"
    },
    "overall_rating": {
      "type": "integer",
      "default": 50,
      "min": 1,
      "max": 100
    },
    "premium_tier": {
      "type": "enumeration",
      "enum": [
        "standard",
        "premium",
        "elite"
      ],
      "default": "standard"
    },
    "template_game_status": {
      "type": "enumeration",
      "enum": [
        "active",
        "inactive",
        "retired"
      ],
      "default": "active"
    },
    "asset_bundle_key": {
      "type": "string"
    },
    "appearance_defaults": {
      "type": "json",
      "default": {
        "modelKey": "player-default-v1",
        "skinTone": "default",
        "hairStyle": "short",
        "kitVariant": "default"
      }
    }
  }
}
