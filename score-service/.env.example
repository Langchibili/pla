SCORE_SERVICE_API_KEY=change-me            # Strapi sends this in X-Api-Key
WEBHOOK_SECRET=change-me-too               # signs results sent back to Strapi
ALLOWED_CALLBACK_HOSTS=strapi              # host names the service may call back
# ALLOW_ANY_CALLBACK=true                  # local development only
WORKERS=2                                  # parallel OCR jobs (CPU bound)
MAX_IMAGE_BYTES=15000000
BLUR_REJECT_BELOW=8
BLUR_FLAG_BELOW=40
AMBIGUITY_MARGIN=0.08
