SCORE_SERVICE_API_KEY=change-me            # Strapi sends this in X-Api-Key
WEBHOOK_SECRET=change-me-too               # signs results sent back to Strapi
ALLOWED_CALLBACK_HOSTS=host.docker.internal,localhost  # callback hosts reachable from a local container; use the reachable Windows host for WSL
# ALLOW_ANY_CALLBACK=true                  # local development only
REQUIRE_CLOCK_FOR_SOCCER_GAMES_VALIDITY=false
WORKERS=2                                  # parallel OCR jobs (CPU bound)
MAX_IMAGE_BYTES=15000000
BLUR_REJECT_BELOW=8
BLUR_FLAG_BELOW=40
AMBIGUITY_MARGIN=0.08
REQUIRE_CLOCK_FOR_SOCCER_GAMES_VALIDITY=true