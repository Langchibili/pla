{
  "kind": "collectionType",
  "collectionName": "referrals",
  "info": {
    "singularName": "referral",
    "pluralName": "referrals",
    "displayName": "Referral"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "referrer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "referred_user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "referral_status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "installed",
        "rewarded"
      ],
      "default": "pending",
      "required": true
    },
    "reward_plapo": {
      "type": "integer",
      "default": 0
    },
    "rewarded_at": {
      "type": "datetime"
    }
  }
}