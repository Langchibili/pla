{
  "kind": "collectionType",
  "collectionName": "email_otp_verifications",
  "info": {
    "singularName": "email-otp",
    "pluralName": "email-otps",
    "displayName": "Email OTP Verification"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "otpEmail": { "type": "email", "required": true },
    "otpCode": { "type": "string", "required": true },
    "otpPurpose": {
      "type": "enumeration",
      "enum": ["login", "signup"],
      "default": "login",
      "required": true
    },
    "otpExpiresAt": { "type": "datetime", "required": true },
    "otpAttempts": { "type": "integer", "default": 0, "required": true },
    "otpLastSentAt": { "type": "datetime", "required": true },
    "referralCode": { "type": "string" },
    "deviceHash": { "type": "string" },
    "countryId": { "type": "integer" }
  }
}
