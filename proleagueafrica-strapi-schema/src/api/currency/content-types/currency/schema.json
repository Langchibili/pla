{
  "kind": "collectionType",
  "collectionName": "currencies",
  "info": {
    "singularName": "currency",
    "pluralName": "currencies",
    "displayName": "Currency"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "code": {
      "type": "string",
      "required": true,
      "unique": true,
      "minLength": 3,
      "maxLength": 3
    },
    "name": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "rate_to_base": {
      "type": "decimal",
      "required": true,
      "default": 1
    },
    "rate_updated_at": {
      "type": "datetime"
    },
    "is_base": {
      "type": "boolean",
      "default": false
    },
    "currency_status": {
      "type": "enumeration",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "required": true
    },
    "countries": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::country.country",
      "mappedBy": "default_currency"
    }
  }
}